[Unit]
Description=Video Monitoring System recorder portal
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
User=vms
Group=vms
WorkingDirectory=/opt/video-monitoring-system
Environment=VMS_RECORDER_DEVICE_CONFIG=/etc/vms/device.json
Environment=VMS_TAILSCALE_SUDO=1
ExecStart=/opt/video-monitoring-system/bin/vms --data-dir /var/lib/video-monitoring-system recorder serve --port 80 --local-network
Restart=on-failure
RestartSec=3
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
# The owner-authenticated web process may run only the exact Tailscale commands
# allowlisted in vms-tailscale.sudoers.
NoNewPrivileges=false
PrivateTmp=true
ProtectHome=true
ProtectSystem=full
ProtectKernelModules=true
ProtectKernelTunables=true
ProtectControlGroups=true
RestrictSUIDSGID=true

[Install]
WantedBy=multi-user.target
