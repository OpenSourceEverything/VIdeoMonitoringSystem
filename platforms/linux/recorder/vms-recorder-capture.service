[Unit]
Description=Video Monitoring System recording worker
Wants=network-online.target vms-recording-ready.path
After=network-online.target

[Service]
Type=oneshot
User=vms
Group=vms
WorkingDirectory=/opt/video-monitoring-system
Environment=VMS_RECORDER_DEVICE_CONFIG=/etc/vms/device.json
ExecStart=/opt/video-monitoring-system/bin/vms --data-dir /var/lib/video-monitoring-system recorder record --frames 100
TimeoutStartSec=45
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=full
ProtectKernelModules=true
ProtectKernelTunables=true
ProtectControlGroups=true
RestrictSUIDSGID=true
