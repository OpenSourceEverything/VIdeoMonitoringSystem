[Unit]
Description=Video Monitoring System recording retention
Wants=vms-recording-ready.path
After=network-online.target

[Service]
Type=oneshot
User=vms
Group=vms
WorkingDirectory=/opt/video-monitoring-system
Environment=VMS_RECORDER_DEVICE_CONFIG=/etc/vms/device.json
ExecStart=/opt/video-monitoring-system/bin/vms --data-dir /var/lib/video-monitoring-system recording maintain
# The legacy MJPEG adapter may need several hours to retire a large first-run
# backlog safely, one validated segment at a time. Normal capture is separate
# and continues while this oneshot runs.
TimeoutStartSec=24h
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=full
ProtectKernelModules=true
ProtectKernelTunables=true
ProtectControlGroups=true
RestrictSUIDSGID=true
